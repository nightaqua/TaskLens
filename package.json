{
  "name": "tasklens",
  "version": "1.3.2",
  "description": "Widget-based dashboard for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "lint:css": "bash scripts/check-css.sh"
  },
  "keywords": [
    "tasks",
    "dashboard",
    "widgets",
    "obsidian",
    "tasklens"
  ],
  "author": "Selim",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/json": "^2.0.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "^8.61.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "tslib": "2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
